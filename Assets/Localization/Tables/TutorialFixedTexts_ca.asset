      m_Items: []
  - m_Id: 2281179328512
    m_Localized: Acaba amb ell!!!
    m_Metadata:
      m_Items: []
  - m_Id: 1986302980096
    m_Localized: T'han atacat, CURAT!
    m_Metadata:
      m_Items: []
  - m_Id: 1610828886016
    m_Localized: Aquest enemic ataca cada cert temps!
    m_Metadata:
      m_Items: []
  - m_Id: 1456474304512
    m_Localized: T'han atacat
    m_Metadata:
      m_Items: []
  - m_Id: 1416443867136
    m_Localized: Si no treus els elements marcats, l'enemic t'atacara amb ells!
    m_Metadata:
      m_Items: []
  - m_Id: 1239981109248
    m_Localized: Acaba amb ell!
    m_Metadata:
      m_Items: []
  - m_Id: 1106333806592
    m_Localized: "Genial! Has llen\xE7at el teu primer encanteri."
    m_Metadata:
      m_Items: []
  - m_Id: 633992261632
    m_Localized: "forma una combinacio de mana que coneguis per llen\xE7ar un encanteri"
    m_Metadata:
      m_Items: []
  - m_Id: 563968356352
    m_Localized: SALTAR TUTO
    m_Metadata:
      m_Items: []
  - m_Id: 416521793536
